# Copy to .env and replace every placeholder. Do not commit .env.
ISSUEBOT_ENV=development
ISSUEBOT_DB_PASSWORD=change-me
ISSUEBOT_DATABASE_URL=postgresql+psycopg://issuebot:change-me@postgres:5432/issuebot
ISSUEBOT_PUBLIC_BASE_URL=http://localhost:8080
ISSUEBOT_ADMIN_USERNAME=admin
ISSUEBOT_ADMIN_PASSWORD=replace-with-12-plus-characters
ISSUEBOT_FERNET_KEY=
ISSUEBOT_DEMO_MODE=false
ISSUEBOT_WORKER_ENABLED=true
ISSUEBOT_PUBLISH_ENABLED=false
ISSUEBOT_ALLOW_PRIVATE_DOCSGPT=false
ISSUEBOT_DOCSGPT_BASE_URL=
ISSUEBOT_DOCSGPT_API_KEY=
ISSUEBOT_DOCSGPT_AGENT_ID=
ISSUEBOT_GITHUB_APP_ID=
ISSUEBOT_GITHUB_PRIVATE_KEY=
ISSUEBOT_GITHUB_PRIVATE_KEY_PATH=
ISSUEBOT_GITHUB_WEBHOOK_SECRET=
ISSUEBOT_ALLOWED_REPOS=
ISSUEBOT_LOG_LEVEL=INFO
